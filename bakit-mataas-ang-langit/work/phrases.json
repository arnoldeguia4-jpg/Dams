{
 "duration": 64.600816,
 "frames": 1938,
 "phrases": [
  {
   "text": "Ayon sa mga Bagobo ng Mindanao,",
   "start": 0.0,
   "end": 2.101
  },
  {
   "text": "ang buwan ay isang suklay.",
   "start": 2.547,
   "end": 4.165
  },
  {
   "text": "Noong unang panahon,",
   "start": 4.945,
   "end": 6.135
  },
  {
   "text": "napakababa ng langit.",
   "start": 6.524,
   "end": 7.913
  },
  {
   "text": "Abot-kamay.",
   "start": 8.464,
   "end": 9.176
  },
  {
   "text": "Puti at matigas,",
   "start": 9.783,
   "end": 11.105
  },
  {
   "text": "parang batong koral.",
   "start": 11.601,
   "end": 12.585
  },
  {
   "text": "May isang babae,",
   "start": 13.274,
   "end": 14.151
  },
  {
   "text": "si Tuglibon,",
   "start": 14.546,
   "end": 15.336
  },
  {
   "text": "na araw-araw nagbabayo ng palay.",
   "start": 15.744,
   "end": 17.901
  },
  {
   "text": "Pero tuwing itataas niya ang halo\u2026 tok!",
   "start": 18.543,
   "end": 21.267
  },
  {
   "text": "Tumatama sa langit.",
   "start": 21.695,
   "end": 22.776
  },
  {
   "text": "Tok!",
   "start": 23.461,
   "end": 23.623
  },
  {
   "text": "Tok!",
   "start": 24.023,
   "end": 24.187
  },
  {
   "text": "Tok!",
   "start": 24.521,
   "end": 24.853
  },
  {
   "text": "Mas madalas pa siyang mauntog kaysa makabayo.",
   "start": 25.326,
   "end": 27.648
  },
  {
   "text": "Kaya hinubad niya ang kanyang kuwintas at suklay,",
   "start": 28.146,
   "end": 30.673
  },
  {
   "text": "at isinabit sa langit,",
   "start": 31.0,
   "end": 32.174
  },
  {
   "text": "para hindi masira.",
   "start": 32.644,
   "end": 33.615
  },
  {
   "text": "\"Langit,\" sabi niya,",
   "start": 34.309,
   "end": 36.069
  },
  {
   "text": "\"umakyat ka naman nang kaunti!\" Hindi gumalaw ang langit.",
   "start": 36.526,
   "end": 40.115
  },
  {
   "text": "Kaya itinaas niya ang halo,",
   "start": 40.756,
   "end": 42.281
  },
  {
   "text": "mas mataas kaysa dati\u2026 at BLAG!",
   "start": 42.586,
   "end": 44.161
  },
  {
   "text": "Umakyat ang langit.",
   "start": 44.642,
   "end": 45.61
  },
  {
   "text": "Pataas,",
   "start": 46.084,
   "end": 46.54
  },
  {
   "text": "nang pataas,",
   "start": 46.54,
   "end": 47.224
  },
  {
   "text": "nang pataas\u2026 dala ang suklay at kuwintas niya.",
   "start": 47.813,
   "end": 50.431
  },
  {
   "text": "Hindi na niya ito nabawi kailanman.",
   "start": 50.881,
   "end": 52.854
  },
  {
   "text": "Kaya tuwing gabi,",
   "start": 53.459,
   "end": 55.381
  },
  {
   "text": "tumingala ka.",
   "start": 55.98,
   "end": 56.874
  },
  {
   "text": "Ang suklay ni Tuglibon ang naging buwan\u2026 at ang mga butil ng kuwintas niya,",
   "start": 57.303,
   "end": 63.109
  },
  {
   "text": "ang mga bituin.",
   "start": 63.491,
   "end": 64.34
  }
 ]
}
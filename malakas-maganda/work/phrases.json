{
 "duration": 68.231837,
 "frames": 2047,
 "phrases": [
  {
   "text": "Ayon sa alamat ng mga Bisaya,",
   "start": 0.0,
   "end": 2.007
  },
  {
   "text": "ang unang tao\u2026 lumabas daw sa isang kawayan.",
   "start": 2.45,
   "end": 5.902
  },
  {
   "text": "At kasalanan ito ng isang pagod na ibon.",
   "start": 6.625,
   "end": 9.728
  },
  {
   "text": "Noong unang panahon,",
   "start": 10.836,
   "end": 12.087
  },
  {
   "text": "walang lupa.",
   "start": 12.422,
   "end": 13.163
  },
  {
   "text": "Langit at dagat lang.",
   "start": 13.8,
   "end": 15.36
  },
  {
   "text": "At sa gitna,",
   "start": 16.065,
   "end": 16.843
  },
  {
   "text": "isang ibong lipad nang lipad.",
   "start": 17.424,
   "end": 19.414
  },
  {
   "text": "Napagod siya.",
   "start": 20.23,
   "end": 21.173
  },
  {
   "text": "Wala siyang madapuan.",
   "start": 21.717,
   "end": 22.994
  },
  {
   "text": "Kaya inaway niya ang dagat.",
   "start": 23.631,
   "end": 25.355
  },
  {
   "text": "Naghampas ang dagat ng alon sa langit.",
   "start": 26.175,
   "end": 28.767
  },
  {
   "text": "Gumanti ang langit.",
   "start": 29.481,
   "end": 30.671
  },
  {
   "text": "Nagbato ito ng malalaking bato sa dagat.",
   "start": 31.267,
   "end": 33.676
  },
  {
   "text": "At ang mga batong iyon\u2026 naging mga isla.",
   "start": 34.303,
   "end": 37.221
  },
  {
   "text": "Sa wakas,",
   "start": 38.188,
   "end": 39.129
  },
  {
   "text": "may madadapuan na ang ibon.",
   "start": 39.472,
   "end": 41.292
  },
  {
   "text": "Pero habang nagpapahinga siya,",
   "start": 42.054,
   "end": 43.695
  },
  {
   "text": "may kawayang tumama sa paa niya.",
   "start": 44.119,
   "end": 46.111
  },
  {
   "text": "Inis na inis,",
   "start": 46.784,
   "end": 47.847
  },
  {
   "text": "tinuka niya ito nang tinuka.",
   "start": 48.193,
   "end": 49.79
  },
  {
   "text": "Hanggang sa nahati ang kawayan\u2026 At lumabas ang isang lalaki at isang babae.",
   "start": 50.449,
   "end": 56.284
  },
  {
   "text": "Si Malakas at si Maganda.",
   "start": 56.951,
   "end": 59.127
  },
  {
   "text": "Kaya ayon sa matatanda,",
   "start": 59.891,
   "end": 61.394
  },
  {
   "text": "nagsimula ang lahat\u2026 dahil may isang ibong napagod lang lumipad.",
   "start": 61.871,
   "end": 66.374
  }
 ]
}
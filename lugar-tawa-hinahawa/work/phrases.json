{
 "duration": 89.887347,
 "frames": 2697,
 "phrases": [
  {
   "text": "Dito sa lugar namin,",
   "start": 0.0,
   "end": 1.348
  },
  {
   "text": "lahat ng mahihirap,",
   "start": 1.348,
   "end": 2.695
  },
  {
   "text": "masaya.",
   "start": 3.096,
   "end": 3.564
  },
  {
   "text": "At lahat ng mayayaman\u2026 malungkot.",
   "start": 4.065,
   "end": 6.43
  },
  {
   "text": "Si Mang Jhano,",
   "start": 7.071,
   "end": 7.959
  },
  {
   "text": "bente pesos lang ang pera.",
   "start": 7.959,
   "end": 9.513
  },
  {
   "text": "Tawa nang tawa.",
   "start": 9.898,
   "end": 10.834
  },
  {
   "text": "Si Don Francis,",
   "start": 11.345,
   "end": 12.436
  },
  {
   "text": "may mansyon at tatlong kotse.",
   "start": 12.436,
   "end": 14.344
  },
  {
   "text": "Iyak nang iyak.",
   "start": 14.682,
   "end": 15.619
  },
  {
   "text": "Ako si Dams.",
   "start": 16.198,
   "end": 17.02
  },
  {
   "text": "Wala akong pera.",
   "start": 17.4,
   "end": 18.246
  },
  {
   "text": "Pero ang tawa ko,",
   "start": 18.755,
   "end": 19.682
  },
  {
   "text": "nakakahawa.",
   "start": 19.931,
   "end": 20.764
  },
  {
   "text": "Kapag tumawa ako,",
   "start": 21.295,
   "end": 22.577
  },
  {
   "text": "tumatawa ang buong kalye.",
   "start": 22.577,
   "end": 23.858
  },
  {
   "text": "Pati ang aso naming si Wangbu.",
   "start": 24.217,
   "end": 25.663
  },
  {
   "text": "Sabi ni Nanay Kimberly,",
   "start": 26.214,
   "end": 27.495
  },
  {
   "text": "\"Anak,",
   "start": 27.913,
   "end": 28.359
  },
  {
   "text": "hindi nabibili ang tawa.",
   "start": 28.709,
   "end": 30.189
  },
  {
   "text": "Hinahawa.\" Isang araw,",
   "start": 30.526,
   "end": 31.238
  },
  {
   "text": "kumatok si Don Francis.",
   "start": 31.877,
   "end": 32.964
  },
  {
   "text": "\"Bibilhin ko ang tawa mo.",
   "start": 32.964,
   "end": 34.206
  },
  {
   "text": "Isang milyon.\" Isang pirma lang\u2026 mayaman na ako.",
   "start": 34.678,
   "end": 36.98
  },
  {
   "text": "Pero hindi na ako makatawa.",
   "start": 37.54,
   "end": 39.648
  },
  {
   "text": "Bumili ako ng kotse.",
   "start": 40.221,
   "end": 41.559
  },
  {
   "text": "Malungkot pa rin.",
   "start": 42.127,
   "end": 43.214
  },
  {
   "text": "Bumili ako ng sampung TV.",
   "start": 43.663,
   "end": 44.453
  },
  {
   "text": "Sampung beses na malungkot.",
   "start": 44.984,
   "end": 46.594
  },
  {
   "text": "Si Don Francis naman,",
   "start": 46.894,
   "end": 48.384
  },
  {
   "text": "tumatawa gamit ang tawa ko\u2026 pero mag-isa sa mansyon.",
   "start": 49.014,
   "end": 51.942
  },
  {
   "text": "Malungkot pa rin.",
   "start": 52.381,
   "end": 53.594
  },
  {
   "text": "Isang gabi,",
   "start": 54.03,
   "end": 54.836
  },
  {
   "text": "mag-isa ako sa balkonahe.",
   "start": 55.4,
   "end": 57.676
  },
  {
   "text": "Sa ibaba,",
   "start": 58.169,
   "end": 58.723
  },
  {
   "text": "sa court,",
   "start": 58.912,
   "end": 59.458
  },
  {
   "text": "nagtatawanan ang mga kapitbahay ko.",
   "start": 59.801,
   "end": 61.698
  },
  {
   "text": "At biglang\u2026 napangiti ako.",
   "start": 62.108,
   "end": 63.952
  },
  {
   "text": "Tapos natawa.",
   "start": 64.383,
   "end": 65.195
  },
  {
   "text": "Hinahawa nga pala ang tawa.",
   "start": 65.639,
   "end": 67.24
  },
  {
   "text": "Doon ko nalaman.",
   "start": 67.745,
   "end": 68.744
  },
  {
   "text": "Hindi pera ang nagpapalungkot sa mayayaman.",
   "start": 68.977,
   "end": 71.592
  },
  {
   "text": "Mag-isa lang silang tumatawa,",
   "start": 71.783,
   "end": 73.338
  },
  {
   "text": "sa likod ng mataas na pader.",
   "start": 73.611,
   "end": 75.151
  },
  {
   "text": "Kaya binuksan ko ang gate.",
   "start": 75.638,
   "end": 76.909
  },
  {
   "text": "Pati si Don Francis,",
   "start": 77.229,
   "end": 78.42
  },
  {
   "text": "sumali sa kainan sa kalye.",
   "start": 78.42,
   "end": 80.008
  },
  {
   "text": "Ngayon,",
   "start": 80.516,
   "end": 80.93
  },
  {
   "text": "dito sa lugar namin,",
   "start": 81.226,
   "end": 82.304
  },
  {
   "text": "masaya na ang lahat.",
   "start": 82.594,
   "end": 83.593
  },
  {
   "text": "Libre kasi ang tawa.",
   "start": 83.863,
   "end": 85.122
  },
  {
   "text": "Hinahawa lang.",
   "start": 85.499,
   "end": 86.574
  },
  {
   "text": "Anong meron sa lugar n'yo?",
   "start": 86.921,
   "end": 88.009
  }
 ]
}
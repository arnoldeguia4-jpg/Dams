{
 "duration": 86.047347,
 "frames": 2581,
 "phrases": [
  {
   "text": "Dito sa lugar namin,",
   "start": 0.0,
   "end": 1.342
  },
  {
   "text": "lahat ng mahihirap,",
   "start": 1.342,
   "end": 2.683
  },
  {
   "text": "masaya.",
   "start": 2.935,
   "end": 3.442
  },
  {
   "text": "At lahat ng mayayaman\u2026 malungkot.",
   "start": 3.974,
   "end": 6.445
  },
  {
   "text": "Si Mang Berto,",
   "start": 6.905,
   "end": 7.889
  },
  {
   "text": "bente pesos lang ang pera.",
   "start": 7.889,
   "end": 9.611
  },
  {
   "text": "Tawa nang tawa.",
   "start": 9.832,
   "end": 10.832
  },
  {
   "text": "Si Don Ramon,",
   "start": 11.336,
   "end": 12.378
  },
  {
   "text": "may mansyon at tatlong kotse.",
   "start": 12.378,
   "end": 14.201
  },
  {
   "text": "Iyak nang iyak.",
   "start": 14.52,
   "end": 15.464
  },
  {
   "text": "Ako?",
   "start": 15.964,
   "end": 16.3
  },
  {
   "text": "Wala akong pera.",
   "start": 16.807,
   "end": 17.614
  },
  {
   "text": "Pero ang tawa ko,",
   "start": 17.851,
   "end": 19.12
  },
  {
   "text": "nakakahawa.",
   "start": 19.12,
   "end": 20.177
  },
  {
   "text": "Kapag tumawa ako,",
   "start": 20.552,
   "end": 21.703
  },
  {
   "text": "tumatawa ang buong kalye.",
   "start": 21.897,
   "end": 23.426
  },
  {
   "text": "Pati ang aso.",
   "start": 23.792,
   "end": 24.547
  },
  {
   "text": "Sabi ni Lola,",
   "start": 25.007,
   "end": 25.823
  },
  {
   "text": "\"Apo,",
   "start": 26.282,
   "end": 26.696
  },
  {
   "text": "hindi nabibili ang tawa.",
   "start": 27.037,
   "end": 28.561
  },
  {
   "text": "Hinahawa.\" Isang araw,",
   "start": 28.849,
   "end": 29.687
  },
  {
   "text": "kumatok si Don Ramon.",
   "start": 30.206,
   "end": 31.129
  },
  {
   "text": "\"Bibilhin ko ang tawa mo.",
   "start": 31.129,
   "end": 32.183
  },
  {
   "text": "Isang milyon.\" Isang pirma lang\u2026 mayaman na ako.",
   "start": 32.674,
   "end": 34.999
  },
  {
   "text": "Pero hindi na ako makatawa.",
   "start": 35.483,
   "end": 37.479
  },
  {
   "text": "Bumili ako ng kotse.",
   "start": 37.987,
   "end": 39.365
  },
  {
   "text": "Malungkot pa rin.",
   "start": 39.819,
   "end": 40.888
  },
  {
   "text": "Bumili ako ng sampung TV.",
   "start": 41.333,
   "end": 42.182
  },
  {
   "text": "Sampung beses na malungkot.",
   "start": 42.536,
   "end": 44.115
  },
  {
   "text": "Si Don Ramon naman,",
   "start": 44.438,
   "end": 45.948
  },
  {
   "text": "tumatawa gamit ang tawa ko\u2026 pero mag-isa sa mansyon.",
   "start": 46.411,
   "end": 49.215
  },
  {
   "text": "Malungkot pa rin.",
   "start": 49.577,
   "end": 50.822
  },
  {
   "text": "Isang gabi,",
   "start": 51.249,
   "end": 52.043
  },
  {
   "text": "mag-isa ako sa balkonahe.",
   "start": 52.5,
   "end": 54.704
  },
  {
   "text": "Sa ibaba,",
   "start": 55.159,
   "end": 55.72
  },
  {
   "text": "sa court,",
   "start": 55.94,
   "end": 56.333
  },
  {
   "text": "nagtatawanan ang mga kapitbahay ko.",
   "start": 56.333,
   "end": 58.694
  },
  {
   "text": "At biglang\u2026 napangiti ako.",
   "start": 59.075,
   "end": 60.969
  },
  {
   "text": "Tapos natawa.",
   "start": 61.428,
   "end": 62.269
  },
  {
   "text": "Hinahawa nga pala ang tawa.",
   "start": 62.678,
   "end": 64.507
  },
  {
   "text": "Doon ko nalaman.",
   "start": 64.913,
   "end": 65.889
  },
  {
   "text": "Hindi pera ang nagpapalungkot sa mayayaman.",
   "start": 66.189,
   "end": 68.52
  },
  {
   "text": "Mag-isa lang silang tumatawa,",
   "start": 68.849,
   "end": 70.26
  },
  {
   "text": "sa likod ng mataas na pader.",
   "start": 70.54,
   "end": 72.126
  },
  {
   "text": "Kaya binuksan ko ang gate.",
   "start": 72.503,
   "end": 73.709
  },
  {
   "text": "Pati si Don Ramon,",
   "start": 73.973,
   "end": 75.081
  },
  {
   "text": "sumali sa kainan sa kalye.",
   "start": 75.081,
   "end": 76.558
  },
  {
   "text": "Ngayon,",
   "start": 76.918,
   "end": 77.346
  },
  {
   "text": "dito sa lugar namin,",
   "start": 77.566,
   "end": 78.594
  },
  {
   "text": "masaya na ang lahat.",
   "start": 78.829,
   "end": 79.644
  },
  {
   "text": "Libre kasi ang tawa.",
   "start": 80.05,
   "end": 81.228
  },
  {
   "text": "Hinahawa lang.",
   "start": 81.642,
   "end": 82.701
  },
  {
   "text": "Anong meron sa lugar n'yo?",
   "start": 83.163,
   "end": 84.4
  }
 ]
}
{
 "duration": 57.965714,
 "frames": 1739,
 "phrases": [
  {
   "text": "May isang lalaking nagtapon ng ginto sa gubat\u2026 dahil mabigat daw.",
   "start": 0.0,
   "end": 4.501
  },
  {
   "text": "Noong unang panahon,",
   "start": 5.451,
   "end": 6.67
  },
  {
   "text": "sa Bundok Makiling sa Laguna,",
   "start": 6.934,
   "end": 8.656
  },
  {
   "text": "nakatira ang isang diwata,",
   "start": 9.008,
   "end": 10.54
  },
  {
   "text": "si Maria Makiling.",
   "start": 11.034,
   "end": 12.264
  },
  {
   "text": "Isang hapon,",
   "start": 12.982,
   "end": 13.769
  },
  {
   "text": "may nakasalubong siyang mangangasong gutom na gutom at walang nahuli.",
   "start": 14.16,
   "end": 17.918
  },
  {
   "text": "Hindi siya binigyan ni Maria ng karne.",
   "start": 18.587,
   "end": 20.538
  },
  {
   "text": "Hindi rin pera.",
   "start": 21.046,
   "end": 21.881
  },
  {
   "text": "Pinuno niya ang salakot nito\u2026 ng luya.",
   "start": 22.506,
   "end": 25.501
  },
  {
   "text": "Luya?",
   "start": 26.04,
   "end": 26.675
  },
  {
   "text": "Habang pababa ng bundok,",
   "start": 27.259,
   "end": 28.574
  },
  {
   "text": "bumibigat nang bumibigat ang salakot.",
   "start": 29.04,
   "end": 31.226
  },
  {
   "text": "Kaya isa-isang itinapon ng mangangaso ang luya sa daan.",
   "start": 31.799,
   "end": 35.123
  },
  {
   "text": "Pagdating sa bahay,",
   "start": 35.733,
   "end": 36.718
  },
  {
   "text": "may natirang isang piraso.",
   "start": 37.156,
   "end": 38.706
  },
  {
   "text": "Kumikinang.",
   "start": 39.289,
   "end": 40.075
  },
  {
   "text": "Ginto!",
   "start": 40.639,
   "end": 41.347
  },
  {
   "text": "Nang kumalat ang balita,",
   "start": 41.928,
   "end": 43.171
  },
  {
   "text": "umakyat ang mga sakim para hukayin ang hardin ng diwata.",
   "start": 43.59,
   "end": 46.783
  },
  {
   "text": "Mula noon,",
   "start": 47.385,
   "end": 48.098
  },
  {
   "text": "hindi na nagpakita si Maria.",
   "start": 48.451,
   "end": 50.117
  },
  {
   "text": "Pero sabi ng matatanda,",
   "start": 50.769,
   "end": 52.056
  },
  {
   "text": "tingnan mo ang Bundok Makiling mula sa malayo\u2026 hugis itong dalagang nakahiga.",
   "start": 52.63,
   "end": 57.653
  }
 ]
}
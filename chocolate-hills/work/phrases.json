{
 "duration": 62.145306,
 "frames": 1864,
 "phrases": [
  {
   "text": "Sa Bohol,",
   "start": 0.0,
   "end": 0.921
  },
  {
   "text": "may mahigit isang libong burol na halos magkakamukha\u2026 at sabi ng matatanda,",
   "start": 1.215,
   "end": 6.781
  },
  {
   "text": "kalat daw ito ng dalawang higante.",
   "start": 7.311,
   "end": 9.538
  },
  {
   "text": "Noong unang panahon,",
   "start": 10.406,
   "end": 11.732
  },
  {
   "text": "may dalawang higanteng nag-away.",
   "start": 11.981,
   "end": 13.763
  },
  {
   "text": "Hindi na maalala kung bakit.",
   "start": 14.386,
   "end": 15.948
  },
  {
   "text": "Basta,",
   "start": 16.486,
   "end": 16.981
  },
  {
   "text": "galit na galit sila.",
   "start": 17.175,
   "end": 18.512
  },
  {
   "text": "Nagbatuhan sila ng bato.",
   "start": 19.135,
   "end": 20.681
  },
  {
   "text": "Tapos ng malalaking tipak ng lupa.",
   "start": 21.233,
   "end": 23.791
  },
  {
   "text": "Tapos ng buhangin.",
   "start": 24.352,
   "end": 25.935
  },
  {
   "text": "Isang araw,",
   "start": 26.859,
   "end": 27.656
  },
  {
   "text": "wala pa ring tumitigil.",
   "start": 27.983,
   "end": 29.537
  },
  {
   "text": "Dalawang araw.",
   "start": 30.141,
   "end": 31.092
  },
  {
   "text": "Tatlo.",
   "start": 31.663,
   "end": 32.245
  },
  {
   "text": "Lima.",
   "start": 32.796,
   "end": 33.354
  },
  {
   "text": "Hanggang sa mapagod silang dalawa\u2026 at napaupo.",
   "start": 34.006,
   "end": 37.436
  },
  {
   "text": "Nagkatinginan sila.",
   "start": 38.336,
   "end": 39.584
  },
  {
   "text": "Natawa.",
   "start": 40.175,
   "end": 40.694
  },
  {
   "text": "At nagkabati.",
   "start": 41.264,
   "end": 42.295
  },
  {
   "text": "Masaya silang umalis ng isla,",
   "start": 42.969,
   "end": 44.732
  },
  {
   "text": "magkaakbay pa.",
   "start": 45.03,
   "end": 45.938
  },
  {
   "text": "Pero may isang problema.",
   "start": 46.666,
   "end": 48.619
  },
  {
   "text": "Nakalimutan nilang linisin ang kalat nila.",
   "start": 49.212,
   "end": 51.699
  },
  {
   "text": "Kaya hanggang ngayon,",
   "start": 52.307,
   "end": 53.406
  },
  {
   "text": "nakatambak pa rin sa Bohol ang mga batong ibinato nila\u2026 Ang tinatawag natin ngayong Chocolate Hills.",
   "start": 53.825,
   "end": 60.419
  }
 ]
}
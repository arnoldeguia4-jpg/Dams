{
 "duration": 54.595918,
 "frames": 1638,
 "phrases": [
  {
   "text": "Why are school buses yellow?",
   "start": 0.12,
   "end": 1.7
  },
  {
   "text": "Blame one stubborn professor.",
   "start": 2.4,
   "end": 4.28
  },
  {
   "text": "In 1939,",
   "start": 5.04,
   "end": 6.18
  },
  {
   "text": "America's school buses were a mess.",
   "start": 6.5,
   "end": 8.7
  },
  {
   "text": "Some were red,",
   "start": 9.24,
   "end": 9.9
  },
  {
   "text": "some were blue,",
   "start": 10.3,
   "end": 10.96
  },
  {
   "text": "some were just farm trucks with benches in the back.",
   "start": 11.54,
   "end": 14.0
  },
  {
   "text": "So Frank Cyr,",
   "start": 14.74,
   "end": 15.88
  },
  {
   "text": "a professor at Columbia University,",
   "start": 16.14,
   "end": 18.0
  },
  {
   "text": "called a big meeting in New York with experts from all over the country.",
   "start": 18.44,
   "end": 22.26
  },
  {
   "text": "He hung 50 strips of paint on the wall,",
   "start": 22.86,
   "end": 25.04
  },
  {
   "text": "from lemon yellow to deep orange red,",
   "start": 25.38,
   "end": 27.66
  },
  {
   "text": "and they argued.",
   "start": 28.32,
   "end": 29.38
  },
  {
   "text": "Finally,",
   "start": 30.06,
   "end": 30.44
  },
  {
   "text": "they picked one shade,",
   "start": 30.68,
   "end": 31.84
  },
  {
   "text": "a bright yellow with a hint of orange.",
   "start": 32.32,
   "end": 34.34
  },
  {
   "text": "Why that one?",
   "start": 35.06,
   "end": 35.66
  },
  {
   "text": "Because your eyes catch it fast,",
   "start": 36.2,
   "end": 38.0
  },
  {
   "text": "even at dawn,",
   "start": 38.32,
   "end": 39.0
  },
  {
   "text": "even in fog,",
   "start": 39.36,
   "end": 40.1
  },
  {
   "text": "even out of the corner of your eye,",
   "start": 40.6,
   "end": 42.24
  },
  {
   "text": "and black letters pop right off it.",
   "start": 42.72,
   "end": 44.76
  },
  {
   "text": "State by state,",
   "start": 45.44,
   "end": 46.2
  },
  {
   "text": "the buses turned yellow.",
   "start": 46.48,
   "end": 47.72
  },
  {
   "text": "That's why school buses are yellow.",
   "start": 48.36,
   "end": 49.92
  },
  {
   "text": "One meeting picked the color,",
   "start": 50.52,
   "end": 51.74
  },
  {
   "text": "and it has protected kids ever since.",
   "start": 52.08,
   "end": 54.34
  }
 ]
}
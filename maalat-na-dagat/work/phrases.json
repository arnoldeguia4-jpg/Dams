{
 "duration": 74.292245,
 "frames": 2229,
 "phrases": [
  {
   "text": "Ayon sa alamat ng mga Ilokano,",
   "start": 0.0,
   "end": 2.124
  },
  {
   "text": "maalat ang dagat…",
   "start": 2.587,
   "end": 3.824
  },
  {
   "text": "dahil sa isang langgam.",
   "start": 4.516,
   "end": 6.141
  },
  {
   "text": "Noong unang panahon,",
   "start": 7.047,
   "end": 8.351
  },
  {
   "text": "matabang pa ang dagat.",
   "start": 8.636,
   "end": 9.906
  },
  {
   "text": "Puwede mo pa itong inumin.",
   "start": 10.565,
   "end": 11.854
  },
  {
   "text": "Pero sa kabilang isla,",
   "start": 12.688,
   "end": 14.027
  },
  {
   "text": "may bundok ng asin.",
   "start": 14.399,
   "end": 15.72
  },
  {
   "text": "At gustong-gusto ito ng mga tao.",
   "start": 16.286,
   "end": 18.573
  },
  {
   "text": "Ang problema,",
   "start": 19.291,
   "end": 20.153
  },
  {
   "text": "walang tulay.",
   "start": 20.552,
   "end": 21.327
  },
  {
   "text": "Kaya humingi sila ng tulong kay Angalo,",
   "start": 21.965,
   "end": 24.227
  },
  {
   "text": "ang higanteng mabait at sobrang tangkad.",
   "start": 24.702,
   "end": 27.565
  },
  {
   "text": "Humiga si Angalo…",
   "start": 28.474,
   "end": 29.642
  },
  {
   "text": "at iniunat ang mga binti niya sa ibabaw ng dagat.",
   "start": 30.097,
   "end": 33.268
  },
  {
   "text": "Siya mismo ang naging tulay.",
   "start": 33.919,
   "end": 35.671
  },
  {
   "text": "Isa-isang tumawid ang mga tao,",
   "start": 36.48,
   "end": 38.526
  },
  {
   "text": "may pasan na mga sako ng asin.",
   "start": 38.933,
   "end": 40.851
  },
  {
   "text": "Isang daan… dalawang daan… tatlong daan.",
   "start": 41.584,
   "end": 44.211
  },
  {
   "text": "Pero sa binti ni Angalo,",
   "start": 44.783,
   "end": 48.05
  },
  {
   "text": "may dumaang isang maliit na langgam.",
   "start": 48.531,
   "end": 50.85
  },
  {
   "text": "At kinagat siya nito.",
   "start": 51.369,
   "end": 52.574
  },
  {
   "text": "\"ARAY!\"",
   "start": 53.06,
   "end": 53.759
  },
  {
   "text": "Napaigtad si Angalo.",
   "start": 54.155,
   "end": 55.687
  },
  {
   "text": "Nahulog ang mga tao sa dagat,",
   "start": 56.22,
   "end": 58.174
  },
  {
   "text": "kasama ang lahat ng asin.",
   "start": 58.479,
   "end": 60.31
  },
  {
   "text": "Nailigtas ang mga tao…",
   "start": 60.996,
   "end": 62.416
  },
  {
   "text": "pero hindi ang asin.",
   "start": 62.943,
   "end": 64.319
  },
  {
   "text": "Kaya ayon sa matatanda,",
   "start": 65.023,
   "end": 66.483
  },
  {
   "text": "hanggang ngayon maalat ang dagat…",
   "start": 67.009,
   "end": 69.461
  },
  {
   "text": "dahil lang sa kagat ng isang langgam.",
   "start": 70.092,
   "end": 72.476
  }
 ]
}
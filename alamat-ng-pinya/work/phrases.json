{
 "duration": 84.062041,
 "frames": 2522,
 "phrases": [
  {
   "text": "Ayon sa alamat,",
   "start": 0.0,
   "end": 1.236
  },
  {
   "text": "may prutas na punô ng mata…",
   "start": 1.583,
   "end": 3.859
  },
  {
   "text": "dahil may isang batang ayaw maghanap.",
   "start": 4.553,
   "end": 7.183
  },
  {
   "text": "Noong unang panahon,",
   "start": 8.28,
   "end": 9.574
  },
  {
   "text": "sa isang maliit na kubo,",
   "start": 9.905,
   "end": 11.509
  },
  {
   "text": "nakatira ang mag-inang si Aling Rosa at si Pinang.",
   "start": 11.937,
   "end": 15.245
  },
  {
   "text": "Mahal na mahal ni Aling Rosa ang anak niya…",
   "start": 16.273,
   "end": 19.019
  },
  {
   "text": "kaya hindi niya ito pinagtatrabaho.",
   "start": 19.607,
   "end": 21.854
  },
  {
   "text": "Isang araw,",
   "start": 22.964,
   "end": 23.811
  },
  {
   "text": "nagkasakit si Aling Rosa.",
   "start": 24.197,
   "end": 25.888
  },
  {
   "text": "Kaya si Pinang ang pinagluto niya ng lugaw.",
   "start": 26.48,
   "end": 29.079
  },
  {
   "text": "\"Inay,",
   "start": 29.917,
   "end": 30.481
  },
  {
   "text": "nasaan po ang kaldero?\"",
   "start": 30.916,
   "end": 32.34
  },
  {
   "text": "\"Inay,",
   "start": 32.892,
   "end": 33.439
  },
  {
   "text": "nasaan po ang bigas?\"",
   "start": 33.796,
   "end": 35.078
  },
  {
   "text": "\"Inay,",
   "start": 35.519,
   "end": 36.228
  },
  {
   "text": "nasaan po ang sandok?\"",
   "start": 36.497,
   "end": 37.878
  },
  {
   "text": "Ang sandok…",
   "start": 38.835,
   "end": 39.821
  },
  {
   "text": "hawak na pala niya.",
   "start": 40.395,
   "end": 41.631
  },
  {
   "text": "Hanggang sa napagod si Aling Rosa at nasabi niya: \"Sana magkaroon ka ng maraming mata…",
   "start": 42.591,
   "end": 45.873
  },
  {
   "text": "para makita mo ang lahat ng hinahanap mo!\"",
   "start": 46.562,
   "end": 52.417
  },
  {
   "text": "Biglang nawala si Pinang.",
   "start": 53.36,
   "end": 55.014
  },
  {
   "text": "Hinanap siya ng buong nayon.",
   "start": 55.632,
   "end": 57.566
  },
  {
   "text": "Wala.",
   "start": 58.194,
   "end": 58.639
  },
  {
   "text": "Pagkalipas ng ilang araw,",
   "start": 59.677,
   "end": 61.244
  },
  {
   "text": "may tumubong kakaibang halaman sa bakuran.",
   "start": 61.665,
   "end": 64.28
  },
  {
   "text": "Dilaw ang bunga nito…",
   "start": 65.078,
   "end": 66.527
  },
  {
   "text": "at punô ng mata.",
   "start": 66.986,
   "end": 68.401
  },
  {
   "text": "Tinawag nila itong Pinang…",
   "start": 69.238,
   "end": 71.095
  },
  {
   "text": "na kalaunan ay naging pinya.",
   "start": 71.633,
   "end": 73.719
  },
  {
   "text": "Kaya ayon sa matatanda,",
   "start": 74.671,
   "end": 76.321
  },
  {
   "text": "punô ng mata ang pinya…",
   "start": 76.945,
   "end": 78.626
  },
  {
   "text": "para makita na niya ang lahat ng hinahanap niya.",
   "start": 79.042,
   "end": 82.286
  }
 ]
}
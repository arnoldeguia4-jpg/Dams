{
 "duration": 108.173061,
 "frames": 3245,
 "phrases": [
  {
   "text": "Dito sa lugar namin,",
   "start": 0.0,
   "end": 1.302
  },
  {
   "text": "lahat may special ability.",
   "start": 1.669,
   "end": 3.404
  },
  {
   "text": "Si Mang Jhano,",
   "start": 3.933,
   "end": 4.732
  },
  {
   "text": "kaya niyang magalit\u2026 kahit walang kaaway.",
   "start": 5.117,
   "end": 7.796
  },
  {
   "text": "Si Ninya,",
   "start": 8.331,
   "end": 8.966
  },
  {
   "text": "nakikipagtsismisan\u2026 kahit mag-isa lang siya.",
   "start": 9.247,
   "end": 12.058
  },
  {
   "text": "Si Justin,",
   "start": 12.572,
   "end": 13.296
  },
  {
   "text": "ang daming trabahong nasisimulan\u2026 pero halos walang natatapos.",
   "start": 13.59,
   "end": 17.615
  },
  {
   "text": "Si Jenny,",
   "start": 18.128,
   "end": 18.752
  },
  {
   "text": "nagagalit\u2026 kahit walang dahilan.",
   "start": 19.075,
   "end": 21.357
  },
  {
   "text": "Si Don Francis,",
   "start": 21.853,
   "end": 22.893
  },
  {
   "text": "nakakapagtrabaho\u2026 kahit tulog.",
   "start": 23.142,
   "end": 25.646
  },
  {
   "text": "Si Wangbu,",
   "start": 26.155,
   "end": 26.809
  },
  {
   "text": "ang aso namin\u2026 nakikipag-usap sa tao.",
   "start": 27.043,
   "end": 29.76
  },
  {
   "text": "Si Kimberly,",
   "start": 30.258,
   "end": 30.988
  },
  {
   "text": "sa online games\u2026 wala pang nakakatalo.",
   "start": 31.266,
   "end": 34.133
  },
  {
   "text": "At ang bago naming kapitbahay,",
   "start": 34.651,
   "end": 36.386
  },
  {
   "text": "si Roger.",
   "start": 36.631,
   "end": 37.305
  },
  {
   "text": "May nunal sa ilalim ng ilong\u2026 at isang turo lang ng daliri niya,",
   "start": 37.651,
   "end": 41.608
  },
  {
   "text": "kinikilig na ang mga babae.",
   "start": 41.902,
   "end": 43.596
  },
  {
   "text": "Ako?",
   "start": 44.139,
   "end": 44.45
  },
  {
   "text": "Si Dams.",
   "start": 45.01,
   "end": 45.654
  },
  {
   "text": "Wala akong special ability.",
   "start": 46.056,
   "end": 47.449
  },
  {
   "text": "Sinubukan kong magalit tulad ni Mang Jhano\u2026 natawa lang ako.",
   "start": 47.888,
   "end": 51.389
  },
  {
   "text": "Sinubukan kong pakiligin si Kimberly gamit ang daliri\u2026 ayun,",
   "start": 51.823,
   "end": 55.542
  },
  {
   "text": "ni-block niya ako.",
   "start": 55.934,
   "end": 56.787
  },
  {
   "text": "Sa lahat ng games.",
   "start": 57.087,
   "end": 58.471
  },
  {
   "text": "Kaya isang gabi,",
   "start": 58.959,
   "end": 59.819
  },
  {
   "text": "umupo ako sa labas.",
   "start": 60.194,
   "end": 61.407
  },
  {
   "text": "Mag-isa.",
   "start": 61.857,
   "end": 62.401
  },
  {
   "text": "\"Bakit ako lang ang wala?\" Tapos may nagsalita sa tabi ko.",
   "start": 63.084,
   "end": 67.013
  },
  {
   "text": "Si Wangbu.",
   "start": 67.597,
   "end": 68.211
  },
  {
   "text": "\"Dams,",
   "start": 68.836,
   "end": 69.333
  },
  {
   "text": "sino ang tumatapos sa mga trabaho ni Justin?",
   "start": 69.718,
   "end": 72.966
  },
  {
   "text": "Ikaw.\" \"Sino ang nagpapatawa kay Jenny pagkatapos niyang magalit?",
   "start": 73.423,
   "end": 77.456
  },
  {
   "text": "Ikaw.\" \"Sino ang nakikinig sa tsismis ni Ninya?",
   "start": 77.794,
   "end": 81.147
  },
  {
   "text": "Ikaw.\" \"At sino ang laging kakampi ni Kimberly\u2026 kaya hindi siya natatalo?",
   "start": 81.536,
   "end": 86.428
  },
  {
   "text": "Ikaw.\" Doon ko lang naintindihan.",
   "start": 86.962,
   "end": 88.467
  },
  {
   "text": "Ang special ability ko pala\u2026 ang mga kaibigan ko.",
   "start": 88.998,
   "end": 92.369
  },
  {
   "text": "Kaya ko silang patawanin.",
   "start": 92.833,
   "end": 94.226
  },
  {
   "text": "Kaya ko silang damayan.",
   "start": 94.669,
   "end": 95.967
  },
  {
   "text": "Kahit ano'ng kailangan nila\u2026 andito ako.",
   "start": 96.39,
   "end": 98.967
  },
  {
   "text": "Kinabukasan,",
   "start": 99.47,
   "end": 100.355
  },
  {
   "text": "tinuro ako ni Roger gamit ang daliri niya\u2026 at kinilig din ako.",
   "start": 100.643,
   "end": 104.491
  },
  {
   "text": "Anong meron sa lugar n'yo?",
   "start": 105.07,
   "end": 106.243
  }
 ]
}
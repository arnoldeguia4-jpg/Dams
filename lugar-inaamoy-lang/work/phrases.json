{
 "duration": 79.647347,
 "frames": 2389,
 "phrases": [
  {
   "text": "Dito sa lugar namin,",
   "start": 0.0,
   "end": 1.097
  },
  {
   "text": "ang alak hindi iniinom\u2026 inaamoy lang.",
   "start": 1.097,
   "end": 2.977
  },
  {
   "text": "Bawal kasi malasing dito.",
   "start": 3.192,
   "end": 6.158
  },
  {
   "text": "Ang problema,",
   "start": 6.496,
   "end": 7.241
  },
  {
   "text": "ang bilis naming malasing.",
   "start": 7.617,
   "end": 8.952
  },
  {
   "text": "Si Mang Jhano,",
   "start": 9.392,
   "end": 10.11
  },
  {
   "text": "isang amoy lang ng beer,",
   "start": 10.437,
   "end": 11.517
  },
  {
   "text": "lasing na.",
   "start": 11.722,
   "end": 12.277
  },
  {
   "text": "Si Caputo,",
   "start": 12.742,
   "end": 13.405
  },
  {
   "text": "isang baso lang,",
   "start": 13.696,
   "end": 14.645
  },
  {
   "text": "tulog agad.",
   "start": 14.645,
   "end": 15.404
  },
  {
   "text": "Ako si Dams,",
   "start": 15.841,
   "end": 16.588
  },
  {
   "text": "taga-amoy lang\u2026 pero ako pa ang nagsuka.",
   "start": 16.904,
   "end": 19.23
  },
  {
   "text": "Kaya ngayon,",
   "start": 19.734,
   "end": 20.221
  },
  {
   "text": "ang inuman namin,",
   "start": 20.221,
   "end": 21.685
  },
  {
   "text": "paamuyan na lang ng takip.",
   "start": 21.9,
   "end": 23.26
  },
  {
   "text": "Si Kuya Steban ang nagbebenta ng takip,",
   "start": 23.713,
   "end": 25.503
  },
  {
   "text": "limang piso isa.",
   "start": 25.869,
   "end": 26.756
  },
  {
   "text": "Si Mang Torres,",
   "start": 27.183,
   "end": 27.951
  },
  {
   "text": "tatlong takip,",
   "start": 28.223,
   "end": 28.837
  },
  {
   "text": "sumayaw sa gitna ng kalsada.",
   "start": 29.106,
   "end": 30.732
  },
  {
   "text": "Si Aling Ninya,",
   "start": 31.18,
   "end": 32.018
  },
  {
   "text": "isang takip,",
   "start": 32.272,
   "end": 32.805
  },
  {
   "text": "kinantahan ang poste.",
   "start": 33.038,
   "end": 34.223
  },
  {
   "text": "Si Don Francis,",
   "start": 34.707,
   "end": 35.616
  },
  {
   "text": "bumili ng gintong takip\u2026 nahimatay.",
   "start": 35.864,
   "end": 38.038
  },
  {
   "text": "Pero ako?",
   "start": 38.59,
   "end": 39.046
  },
  {
   "text": "Isang singhot lang,",
   "start": 39.536,
   "end": 40.416
  },
  {
   "text": "suka agad.",
   "start": 40.616,
   "end": 41.365
  },
  {
   "text": "Tatlong beses ngayong linggo.",
   "start": 41.781,
   "end": 43.246
  },
  {
   "text": "Sabi ni Nanay Kimberly,",
   "start": 43.74,
   "end": 44.919
  },
  {
   "text": "\"Anak,",
   "start": 45.333,
   "end": 45.846
  },
  {
   "text": "hindi alak ang problema mo.\" Isang gabi,",
   "start": 46.178,
   "end": 49.063
  },
  {
   "text": "si Wangbu,",
   "start": 49.291,
   "end": 49.932
  },
  {
   "text": "inamoy din ang takip\u2026 bumahing,",
   "start": 50.19,
   "end": 52.012
  },
  {
   "text": "tapos tumakbo.",
   "start": 52.265,
   "end": 53.024
  },
  {
   "text": "Sinundan siya nina Biboy at Jenny,",
   "start": 53.334,
   "end": 55.189
  },
  {
   "text": "hanggang sa tindahan ni Aling Ninya.",
   "start": 55.189,
   "end": 57.045
  },
  {
   "text": "At doon nila nakita,",
   "start": 57.38,
   "end": 58.496
  },
  {
   "text": "sa likod ng tindahan,",
   "start": 58.811,
   "end": 59.943
  },
  {
   "text": "isang sakong takip.",
   "start": 60.232,
   "end": 61.309
  },
  {
   "text": "Hindi pala galing sa bote ng beer\u2026 galing sa bote ng suka!",
   "start": 61.887,
   "end": 65.503
  },
  {
   "text": "Buong barangay pala,",
   "start": 65.977,
   "end": 67.07
  },
  {
   "text": "nalalasing sa suka.",
   "start": 67.07,
   "end": 68.345
  },
  {
   "text": "Kaya pala ako nagsusuka\u2026 suka pala ang inaamoy ko.",
   "start": 68.582,
   "end": 72.264
  },
  {
   "text": "Ngayon,",
   "start": 72.806,
   "end": 73.194
  },
  {
   "text": "bago kaming patakaran: bawal na ring sumawsaw.",
   "start": 73.509,
   "end": 76.184
  },
  {
   "text": "Anong meron sa lugar n'yo?",
   "start": 76.707,
   "end": 77.736
  }
 ]
}